{
  "repositories": {
    "description": "监控的 GitHub/GitLab 公开仓库",
    "type": "template_list",
    "default": [],
    "hint": "每个仓库可独立勾选 Commit、正式 Release、Pre-release",
    "templates": {
      "repository": {
        "name": "代码仓库",
        "display_item": "repository",
        "items": {
          "platform": {
            "description": "平台",
            "type": "string",
            "default": "github",
            "hint": "填写 github 或 gitlab"
          },
          "repository": {
            "description": "仓库",
            "type": "string",
            "hint": "填写 owner/repo、GitHub 地址或 GitLab 地址"
          },
          "branch": {
            "description": "Commit 分支",
            "type": "string",
            "default": "",
            "hint": "留空使用平台默认分支"
          },
          "monitor_commit": {
            "description": "监控 Commit",
            "type": "bool",
            "default": false
          },
          "monitor_release": {
            "description": "监控正式 Release",
            "type": "bool",
            "default": false
          },
          "monitor_prerelease": {
            "description": "监控 Pre-release",
            "type": "bool",
            "default": false
          }
        }
      }
    }
  },
  "github_token": {
    "description": "GitHub Token",
    "type": "string",
    "default": "",
    "hint": "可选，用于提高 GitHub API 请求额度"
  },
  "check_interval_minutes": {
    "description": "检查间隔 (分钟)",
    "type": "int",
    "default": 30,
    "hint": "最小 1 分钟"
  },
  "notify_on_first_run": {
    "description": "首次运行时通知当前状态",
    "type": "bool",
    "default": false
  },
  "gotify_channels": {
    "description": "Gotify 通知渠道",
    "type": "template_list",
    "default": [],
    "templates": {
      "gotify": {
        "name": "Gotify",
        "display_item": "name",
        "items": {
          "name": {
            "description": "渠道名称",
            "type": "string",
            "default": "Gotify"
          },
          "url": {
            "description": "Gotify Url",
            "type": "string"
          },
          "token": {
            "description": "Gotify App Token",
            "type": "string"
          },
          "priority": {
            "description": "Priority",
            "type": "int",
            "default": 5
          }
        }
      }
    }
  }
}
