{
  "repositories": {
    "description": "监控的 GitHub 仓库",
    "type": "template_list",
    "default": [],
    "hint": "每个仓库可单独设置是否包含预发布版本",
    "templates": {
      "github": {
        "name": "GitHub 仓库",
        "display_item": "repo",
        "items": {
          "repo": {
            "description": "仓库",
            "type": "string",
            "hint": "填写 owner/repo，也支持 GitHub 仓库地址"
          },
          "include_prereleases": {
            "description": "包含预发布版本",
            "type": "bool",
            "default": false,
            "hint": "开启后会监控 Pre-release"
          }
        }
      }
    }
  },
  "github_token": {
    "description": "GitHub Token",
    "type": "string",
    "default": "",
    "hint": "可选。用于提高 GitHub API 请求额度"
  },
  "check_interval_minutes": {
    "description": "检查间隔（分钟）",
    "type": "int",
    "default": 30,
    "hint": "最小 1 分钟"
  },
  "include_prereleases": {
    "description": "旧版全局预发布设置（迁移兼容）",
    "type": "bool",
    "default": false,
    "invisible": true
  },
  "notify_on_first_run": {
    "description": "首次运行时通知当前版本",
    "type": "bool",
    "default": false
  },
  "gotify_channels": {
    "description": "Gotify 通知渠道",
    "type": "template_list",
    "default": [],
    "hint": "可配置多个 Gotify 服务",
    "templates": {
      "gotify": {
        "name": "Gotify",
        "display_item": "name",
        "items": {
          "name": {
            "description": "渠道名称",
            "type": "string",
            "default": "Gotify"
          },
          "url": {
            "description": "Gotify 服务地址",
            "type": "string",
            "hint": "例如 https://gotify.example.com"
          },
          "token": {
            "description": "Gotify App Token",
            "type": "string",
            "hint": "填写 Gotify 应用的 Token"
          },
          "priority": {
            "description": "消息优先级",
            "type": "int",
            "default": 5
          }
        }
      }
    }
  }
}
